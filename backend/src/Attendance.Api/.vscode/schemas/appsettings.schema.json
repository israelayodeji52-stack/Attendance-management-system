{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Minimal appsettings.json schema for Attendance.Api",
    "type": "object",
    "properties": {
        "Logging": {
            "type": "object",
            "properties": {
                "LogLevel": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": true
        },
        "Jwt": {
            "type": "object",
            "properties": {
                "Secret": {
                    "type": "string"
                },
                "Issuer": {
                    "type": "string"
                },
                "Audience": {
                    "type": "string"
                },
                "ExpiryInHours": {
                    "type": "number"
                }
            },
            "required": [
                "Secret",
                "Issuer",
                "Audience"
            ],
            "additionalProperties": true
        },
        "AllowedHosts": {
            "type": "string"
        }
    },
    "additionalProperties": true
}